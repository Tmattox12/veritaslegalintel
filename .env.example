# ===== Veritas Backend Configuration =====
# Copy this file to .env and fill in your values.

# --- AI ---
# Your Anthropic API key from https://console.anthropic.com/api_keys
# Used for Claude document categorization fallback + vision OCR of scanned PDFs/images.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Server port (defaults to 3000)
PORT=3000

# --- Storage (original uploaded files) ---
# local (default) = save originals to server/uploads/ on this machine.
# azure          = upload originals to Azure Blob Storage (private container).
STORAGE_MODE=local

# Only needed when STORAGE_MODE=azure:
# Azure Storage connection string (Azure Portal -> Storage account -> Access keys)
AZURE_STORAGE_CONNECTION_STRING=
# Blob container name (auto-created). Keep it PRIVATE.
AZURE_STORAGE_CONTAINER=veritas-documents

# --- On-Prem Tunnel (optional) ---
# Exposes this local API to Azure without opening inbound firewall ports.
# none (default) = local-only development.
# relay          = connect out to an Azure Relay Hybrid Connection.
TUNNEL_MODE=none

# Only needed when TUNNEL_MODE=relay:
RELAY_NAMESPACE=
RELAY_CONNECTION_NAME=
RELAY_KEY_NAME=
RELAY_KEY=

# --- Authentication (Microsoft Entra) ---
# none (default) = OPEN API for LOCAL development only. Do NOT expose publicly.
# entra          = require Microsoft Entra sign-in for all /api requests.
AUTH_MODE=none

# Only needed when AUTH_MODE=entra (from your Entra app registration):
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Optional override of the scope the frontend requests (defaults to api://<clientId>/access_as_user)
ENTRA_API_SCOPE=
